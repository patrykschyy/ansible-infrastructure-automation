#cloud-config
hostname: {{ item.name }}
manage_etc_hosts: true

users:
  - name: {{ kvm_default_user }}
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
        - {{ lookup('file', playbook_dir + '/../files/ssh/id_ed25519.pub') }}

package_update: true
packages:
  - qemu-guest-agent
  - curl
  - wget
  - vim
  - htop
  - net-tools
  - ca-certificates

runcmd:
  - systemctl enable --now qemu-guest-agent
