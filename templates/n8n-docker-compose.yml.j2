services:
  n8n:
    image: n8nio/n8n:${N8N_VERSION}
    container_name: n8n
    restart: unless-stopped

    ports:
      - "{{ n8n_tailscale_ip }}:{{ n8n_port }}:5678"

    env_file:
      - .env

    environment:
      - N8N_HOST=0.0.0.0
      - N8N_PORT=5678
      - N8N_PROTOCOL=http

      - WEBHOOK_URL=https://{{ n8n_domain }}
      - N8N_EDITOR_BASE_URL=https://{{ n8n_domain }}
      - N8N_PROXY_HOPS=1

      - TZ={{ n8n_timezone }}
      - GENERIC_TIMEZONE={{ n8n_timezone }}


    volumes:
      - ./.n8n:/home/node/.n8n
      - ./data:/data/storage
