# ==========================================
# 1. PATHS AND BASICS
# ==========================================
export ZSH="$HOME/.oh-my-zsh"
export LANG=en_US.UTF-8
export EDITOR='vim'
export PAGER='less'
export HISTFILE="$HOME/.zsh_history"

# ==========================================
# 2. OH MY ZSH PLUGINS
# ==========================================
plugins=(
    git
    sudo
    docker
    docker-compose
    extract
    web-search
    zsh-autosuggestions
    zsh-syntax-highlighting
)

# Load Oh My Zsh
if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# ==========================================
# 3. PROMPT
# ==========================================
ZSH_THEME=""

PROMPT='%F{214}%n%f@%F{39}%m%f %F{39}%~%f
%F{214}➜%f '

# Autosuggestion color
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=244"

# ==========================================
# 4. HISTORY
# ==========================================
bindkey '^[[A' up-line-or-search
bindkey '^[[B' down-line-or-search

HISTSIZE=20000
SAVEHIST=20000

setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_VERIFY
setopt HIST_IGNORE_SPACE

# ==========================================
# 5. SYSTEM ALIASES
# ==========================================
alias ..="cd .."
alias ...="cd ../.."
alias ll="ls -lahF --color=auto"
alias c='clear'

alias update='sudo apt update && sudo apt upgrade -y'

# Safer file operations
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ==========================================
# 6. DEVOPS / ADMIN ALIASES
# ==========================================
alias d="docker"
alias dc="docker compose"

alias dps="docker ps --format 'table {{ '{{' }}.Names{{ '}}' }}\t{{ '{{' }}.Status{{ '}}' }}\t{{ '{{' }}.Ports{{ '}}' }}'"
alias dpsa="docker ps -a --format 'table {{ '{{' }}.Names{{ '}}' }}\t{{ '{{' }}.Status{{ '}}' }}\t{{ '{{' }}.Image{{ '}}' }}\t{{ '{{' }}.Ports{{ '}}' }}'"

alias dlog="docker logs -f --tail=100"
alias dimg="docker images"
alias dnet="docker network ls"
alias dvol="docker volume ls"

# WARNING: Stops all running containers
alias docker-stop-all='docker stop $(docker ps -q)'

# WSL / Windows Explorer
alias explorer="explorer.exe ."

# ==========================================
# 7. SYSTEM DEBUGGING
# ==========================================
alias ports="sudo ss -tulpen"
alias listen="sudo lsof -i -P -n | grep LISTEN"

alias dfh="df -h"
alias duh="du -h --max-depth=1"

alias freeh="free -h"
alias mem="free -h"

alias journal="sudo journalctl -xe"
alias journalf="sudo journalctl -f"

alias services="systemctl --type=service --state=running"

# ==========================================
# 8. NETWORK
# ==========================================
alias myip="curl -4 -s ifconfig.me && echo"
alias localip="ip -br addr"
alias routes="ip route"

alias pingg="ping 8.8.8.8"
alias digg="dig +short"

# ==========================================
# 9. FUNCTIONS
# ==========================================

# mkdir + cd
take() {
    mkdir -p "$1" && cd "$1"
}

# Alternative mkdir + cd
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# ==========================================
# 10. ZSH CONFIG
# ==========================================
alias zshconfig="vim ~/.zshrc"
alias zshreload="source ~/.zshrc"

# ==========================================
# 11. OPTIONAL STARTUP
# ==========================================

